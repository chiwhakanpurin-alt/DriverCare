import cv2
import mediapipe as mp
import time
import math
import numpy as np
import sys

# ===== EYE CONFIG =====
EAR_THRESHOLD = 0.23
EYE_CLOSE_TIME = 2.0
BLINK_FRAMES = 2

# ===== YAWN CONFIG =====
MAR_THRESHOLD = 0.35
YAWN_WINDOW = 30.0
YAWN_COUNT_THRESHOLD = 2
YAWN_RESET_TIME = 5.0

# ===== HEAD DOWN CONFIG =====
HEAD_DOWN_THRESHOLD = 0.08
HEAD_DOWN_TIME = 2.0
HEAD_ALERT_DURATION = 10.0

# ===== MEDIAPIPE =====
mp_face = mp.solutions.face_mesh
face_mesh = mp_face.FaceMesh(
   max_num_faces=1,
   refine_landmarks=False,
   min_detection_confidence=0.5,
   min_tracking_confidence=0.5
)

# ===== CAMERA (Pi 5 สำคัญมาก) =====
cap = cv2.VideoCapture(0, cv2.CAP_V4L2)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

if not cap.isOpened():
   print("Camera not opened")
   sys.exit(1)
else:
   print("Camera opened")

# ===== STATE =====
eye_close_start = None
eye_state = "OPEN"
closed_frame_count = 0

yawn_times = []
yawn_state = "NORMAL"
first_yawn_time = None

head_down_start = None
head_alert_start = None
head_state = "NORMAL"

# ===== LANDMARK INDEX =====
LEFT_EYE = [33, 160, 158, 133, 153, 144]
RIGHT_EYE = [362, 385, 387, 263, 373, 380]
MOUTH = [78, 13, 14, 308, 312, 82]
NOSE_TIP = 1

def distance(p1, p2):
   return math.dist(p1, p2)

def ear_calc(eye):
   A = distance(eye[1], eye[5])
   B = distance(eye[2], eye[4])
   C = distance(eye[0], eye[3])
   return (A + B) / (2 * C)

def mar_calc(mouth):
   A = distance(mouth[1], mouth[5])
   B = distance(mouth[2], mouth[4])
   C = distance(mouth[0], mouth[3])
   return (A + B) / (2 * C)

print("Running detection (ESC to exit)")

while True:
   ret, frame = cap.read()
   if not ret:
       print("No frame")
       break

   frame = cv2.flip(frame, 1)
   h, w, _ = frame.shape
   rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
   res = face_mesh.process(rgb)
   now = time.time()

   if res.multi_face_landmarks:
       face = res.multi_face_landmarks[0]

       le, re, mouth = [], [], []

       for i in LEFT_EYE:
           lm = face.landmark[i]
           le.append((int(lm.x * w), int(lm.y * h)))

       for i in RIGHT_EYE:
           lm = face.landmark[i]
           re.append((int(lm.x * w), int(lm.y * h)))

       for i in MOUTH:
           lm = face.landmark[i]
           mouth.append((int(lm.x * w), int(lm.y * h)))

       ear = (ear_calc(le) + ear_calc(re)) / 2
       mar = mar_calc(mouth)

       # ---------- EYE LOGIC ----------
       if ear < EAR_THRESHOLD:
           closed_frame_count += 1
       else:
           closed_frame_count = 0
           eye_state = "OPEN"
           eye_close_start = None

       if closed_frame_count >= BLINK_FRAMES:
           eye_state = "CLOSED"
           if eye_close_start is None:
               eye_close_start = now

       elapsed = now - eye_close_start if eye_close_start else 0

       # ---------- YAWN LOGIC ----------
       if mar > MAR_THRESHOLD:
           if len(yawn_times) == 0 or now - yawn_times[-1] > 1.5:
               yawn_times.append(now)
               if first_yawn_time is None:
                   first_yawn_time = now

       yawn_times = [t for t in yawn_times if now - t <= YAWN_WINDOW]

       if first_yawn_time:
           if (now - first_yawn_time) >= YAWN_RESET_TIME and len(yawn_times) <= YAWN_COUNT_THRESHOLD:
               yawn_times.clear()
               first_yawn_time = None
               yawn_state = "NORMAL"

       yawn_state = "YAWN ALERT" if len(yawn_times) > YAWN_COUNT_THRESHOLD else "NORMAL"

       # ---------- HEAD DOWN LOGIC ----------
       nose_y = face.landmark[NOSE_TIP].y

       if nose_y > (0.5 + HEAD_DOWN_THRESHOLD):
           if head_down_start is None:
               head_down_start = now
       else:
           head_down_start = None
           if head_alert_start is None:
               head_state = "NORMAL"

       if head_down_start and (now - head_down_start) >= HEAD_DOWN_TIME:
           if head_alert_start is None:
               head_alert_start = now
               head_state = "HEAD DOWN ALERT"

       if head_alert_start and (now - head_alert_start) >= HEAD_ALERT_DURATION:
           head_alert_start = None
           head_down_start = None
           head_state = "NORMAL"

       # ---------- DRAW ----------
       eye_color = (0,255,0) if eye_state=="OPEN" else (0,0,255)
       cv2.polylines(frame, [np.array(le)], True, eye_color, 2)
       cv2.polylines(frame, [np.array(re)], True, eye_color, 2)
       cv2.polylines(frame, [np.array(mouth)], True, (255,255,0), 2)

       cv2.putText(frame, f"EAR: {ear:.2f}", (30,40),
                   cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255,255,0), 2)
       cv2.putText(frame, f"EYES: {eye_state}", (30,75),
                   cv2.FONT_HERSHEY_SIMPLEX, 0.9, eye_color, 2)

       if eye_state=="CLOSED":
           cv2.putText(frame, f"CLOSED {elapsed:.1f}s", (30,110),
                       cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0,255,255), 2)

       if elapsed >= EYE_CLOSE_TIME:
           cv2.putText(frame, "DROWSINESS ALERT !!!", (30,155),
                       cv2.FONT_HERSHEY_SIMPLEX, 1.1, (0,0,255), 3)

       cv2.putText(frame, f"MAR: {mar:.2f}", (30,195),
                   cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255,255,0), 2)
       cv2.putText(frame, f"YAWNS (30s): {len(yawn_times)}", (30,230),
                   cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0,255,255), 2)

       if yawn_state == "YAWN ALERT":
           cv2.putText(frame, "YAWNING ALERT !!!", (30,270),
                       cv2.FONT_HERSHEY_SIMPLEX, 1.1, (0,0,255), 3)

       cv2.putText(frame, f"HEAD: {head_state}", (30,305),
                   cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255,255,0), 2)

       if head_state == "HEAD DOWN ALERT":
           cv2.putText(frame, "HEAD DOWN ALERT !!!", (30,345),
                       cv2.FONT_HERSHEY_SIMPLEX, 1.1, (0,0,255), 3)

   cv2.imshow("Eye + Yawn + Head Down Detection (Pi 5)", frame)
   if cv2.waitKey(1) & 0xFF == 27:
